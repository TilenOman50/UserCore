# Copy to .env and fill in. See /settings/api-keys in the UserCore dashboard.

# The workspace API key (uc_…). Used by Vite's /api/start-session middleware
# to create verification sessions on the workspace's behalf. Never reaches the
# browser.
USERCORE_API_KEY=uc_paste_your_workspace_api_key_here

# Optional. If set, every session uses this workflow. If omitted, the
# workspace's "default" workflow is used (set one via the workflow editor).
# USERCORE_WORKFLOW_ID=

# Optional. Defaults to http://localhost:3004 for local dev.
# USERCORE_API_URL=http://localhost:3004
