{
  "name": "@usercore/scenarios-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && bun run --watch src/index.ts | pino-pretty",
    "start": "bun run src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "TZ=UTC APP_ENV=local bun test test/",
    "db:migrate": "bun scripts/migrate.ts | pino-pretty",
    "db:generate-migration": "bun --bun drizzle-kit generate",
    "db:studio": "bun --bun drizzle-kit studio --port 4005",
    "db:check": "bun --bun drizzle-kit check",
    "prettier": "prettier 'src/' --check",
    "prettier:fix": "prettier 'src/' --write"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.19.10",
    "@usercore/logger": "workspace:*",
    "@usercore/rabbitmq": "workspace:*",
    "@usercore/shared-types": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.7",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@types/pg": "^8.11.13",
    "@usercore/eslint-config": "workspace:*",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.3"
  }
}
